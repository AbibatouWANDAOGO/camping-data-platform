      <bpmndi:BPMNShape id="Task_Remise_di" bpmnElement="Task_Remise"><dc:Bounds x="1470" y="525" width="160" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Installe_di" bpmnElement="End_Installe"><dc:Bounds x="1680" y="542" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1648" y="582" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_Nuit_di" bpmnElement="Timer_Nuit"><dc:Bounds x="210" y="682" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="173" y="722" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Depot_di" bpmnElement="Task_Depot"><dc:Bounds x="290" y="665" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Bronze_di" bpmnElement="Task_Bronze"><dc:Bounds x="460" y="665" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Silver_di" bpmnElement="Task_Silver"><dc:Bounds x="630" y="665" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Valide_di" bpmnElement="GW_Valide" isMarkerVisible="true"><dc:Bounds x="800" y="675" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Rejet_di" bpmnElement="Task_Rejet"><dc:Bounds x="755" y="765" width="140" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejet_di" bpmnElement="End_Rejet"><dc:Bounds x="960" y="777" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="913" y="817" width="130" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Gold_di" bpmnElement="Task_Gold"><dc:Bounds x="880" y="665" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Purge_di" bpmnElement="Task_Purge"><dc:Bounds x="1050" y="665" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Qualite_di" bpmnElement="Task_Qualite"><dc:Bounds x="1220" y="665" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Qualite_di" bpmnElement="GW_Qualite" isMarkerVisible="true"><dc:Bounds x="1390" y="675" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Arret_di" bpmnElement="End_Arret"><dc:Bounds x="1500" y="682" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1433" y="722" width="170" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Publier_di" bpmnElement="Task_Publier"><dc:Bounds x="1480" y="870" width="150" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OK_di" bpmnElement="End_OK"><dc:Bounds x="1690" y="887" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1653" y="927" width="110" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Doc_ExportOTA_di" bpmnElement="Doc_ExportOTA"><dc:Bounds x="1090" y="245" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TA_1_di" bpmnElement="TA_1"><dc:Bounds x="540" y="765" width="200" height="75"/></bpmndi:BPMNShape>
