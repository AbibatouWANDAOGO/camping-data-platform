      <bpmndi:BPMNShape id="Start_Souhait_di" bpmnElement="Start_Souhait"><dc:Bounds x="210" y="112" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="178" y="152" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Canal_di" bpmnElement="Task_Canal"><dc:Bounds x="290" y="95" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Canal_di" bpmnElement="GW_Canal" isMarkerVisible="true"><dc:Bounds x="470" y="105" width="50" height="50"/></bpmndi:BPMNShape>
