<mxfile host="app.diagrams.net"><diagram name="C4 niveau 3 - Traitements de nuit" id="C4_niveau_3_-_Traitements_de_nuit"><mxGraphModel dx="1060" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b0" value="Traitements de nuit [Databricks]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#555555;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="15" y="20" width="1030" height="560" as="geometry"/></mxCell><mxCell id="job" value="&lt;b&gt;Job de nuit&lt;/b&gt;&lt;br&gt;[Databricks Jobs]&lt;br&gt;&lt;br&gt;Lance chaque étape dans l'ordre ; arrêt si un contrôle échoue" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="48" width="200" height="66" as="geometry"/></mxCell><mxCell id="n01" value="&lt;b&gt;Notebook 01&lt;/b&gt;&lt;br&gt;[Databricks SQL, une fois]&lt;br&gt;&lt;br&gt;Crée les tables, clés, CHECK, masque et étiquettes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="40" width="150" height="100" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;1. Extraction PMS&lt;/b&gt;&lt;br&gt;[Tâche du job, 4 h 30]&lt;br&gt;&lt;br&gt;Copie les tables du PMS dans le dépôt" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="205" y="175" width="150" height="105" as="geometry"/></mxCell><mxCell id="pip" value="&lt;b&gt;2. Pipeline bronze&lt;/b&gt;&lt;br&gt;[Lakeflow, 5 h]&lt;br&gt;&lt;br&gt;Charge une table bronze par fichier" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="375" y="175" width="150" height="105" as="geometry"/></mxCell><mxCell id="n02" value="&lt;b&gt;3. Notebook 02&lt;/b&gt;&lt;br&gt;[Databricks SQL, 5 h]&lt;br&gt;&lt;br&gt;Lit le bronze, remplit silver puis gold" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="175" width="150" height="105" as="geometry"/></mxCell><mxCell id="n04" value="&lt;b&gt;4. Notebook 04 (à construire)&lt;/b&gt;&lt;br&gt;[Databricks SQL, 5 h 15]&lt;br&gt;&lt;br&gt;Efface les données échues, silver et bronze, puis VACUUM" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#BBD6F0;strokeColor=#2E6DA4;fontColor=#12304F;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="715" y="175" width="150" height="105" as="geometry"/></mxCell><mxCell id="n03" value="&lt;b&gt;5. Notebook 03 (à construire)&lt;/b&gt;&lt;br&gt;[Databricks SQL, 5 h 20]&lt;br&gt;&lt;br&gt;Contrôle les résultats ; alerte et arrêt si échec" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#BBD6F0;strokeColor=#2E6DA4;fontColor=#12304F;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="885" y="175" width="140" height="105" as="geometry"/></mxCell><mxCell id="dep" value="&lt;b&gt;Dépôt&lt;/b&gt;&lt;br&gt;[Volume Unity Catalog]&lt;br&gt;&lt;br&gt;pms/, ota/, iot/, clients/…" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="205" y="450" width="150" height="80" as="geometry"/></mxCell><mxCell id="br" value="&lt;b&gt;Bronze&lt;/b&gt;&lt;br&gt;[8 tables Delta]&lt;br&gt;&lt;br&gt;Copie brute des fichiers" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="450" width="150" height="80" as="geometry"/></mxCell><mxCell id="sl" value="&lt;b&gt;Silver&lt;/b&gt;&lt;br&gt;[15 tables Delta]&lt;br&gt;&lt;br&gt;Données typées et valides" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="450" width="150" height="80" as="geometry"/></mxCell><mxCell id="gd" value="&lt;b&gt;Gold&lt;/b&gt;&lt;br&gt;[4 tables Delta]&lt;br&gt;&lt;br&gt;Quatre data products" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="450" width="150" height="80" as="geometry"/></mxCell><mxCell id="e0" value="lancé une fois, à la création" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="job" target="n01"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="1" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="job" target="ext"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="job" target="pip"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="job" target="n02"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="4" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="job" target="n0